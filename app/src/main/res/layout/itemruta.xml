<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginStart="16dp"
    android:layout_marginEnd="16dp"
    android:layout_marginTop="4dp"
    android:layout_marginBottom="4dp"
    app:cardCornerRadius="16dp"
    app:cardElevation="2dp"
    app:strokeWidth="1dp"
    app:strokeColor="#E0E0E0"
    app:cardBackgroundColor="#FFFFFF">

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="16dp"
        android:background="?android:attr/selectableItemBackground">

        <!-- Thumbnail circular -->

        <!-- Contenedor de texto -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_toStartOf="@id/imgItem"
            android:layout_centerVertical="true"
            android:orientation="vertical">

            <!-- Medidor -->
            <TextView
                android:id="@+id/txtMedidor"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="MED-12345"
                android:textColor="#0052FF"
                android:textSize="18sp"
                android:textStyle="bold"
                android:fontFamily="sans-serif-black"
                android:layout_marginBottom="4dp" />

            <!-- Dirección -->
            <TextView
                android:id="@+id/txtDireccion"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Calle 123 # 45-67"
                android:textColor="#546e7a"
                android:textSize="13sp"
                android:fontFamily="sans-serif"
                android:maxLines="1"
                android:ellipsize="end"
                android:drawableStart="@drawable/ic_dir"
                android:drawablePadding="4dp"
                android:drawableTint="#8E8E93"
                android:layout_marginBottom="2dp" />

            <!-- Ruta -->
            <TextView
                android:id="@+id/txtRuta"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Ruta 001"
                android:textColor="#3B4D55"
                android:textSize="13sp"
                android:fontFamily="sans-serif"
                android:textStyle="bold"
                android:drawableStart="@drawable/ic_ruta"
                android:drawablePadding="4dp"
                android:drawableTint="#8E8E93"
                android:layout_marginBottom="2dp" />

            <!-- Nombre -->
            <TextView
                android:id="@+id/txtNombre"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Juan Pérez"
                android:textColor="#1C1C1E"
                android:textSize="13sp"
                android:fontFamily="sans-serif"
                android:maxLines="1"
                android:ellipsize="end"
                android:drawableStart="@drawable/ic_user"
                android:drawablePadding="4dp"
                android:drawableTint="#8E8E93" />
        </LinearLayout>

        <!-- Imagen directamente como ImageView (compatible con código original) -->
        <ImageView
            android:id="@+id/imgItem"
            android:layout_width="70dp"
            android:layout_height="70dp"
            android:layout_alignParentEnd="true"
            android:layout_centerVertical="true"
            android:background="@drawable/bg_image_circle"
            android:padding="12dp"
            android:scaleType="fitCenter"
            android:visibility="visible" />

    </RelativeLayout>

</com.google.android.material.card.MaterialCardView>