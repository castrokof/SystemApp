<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="4dp"
    app:cardCornerRadius="8dp"
    app:cardElevation="2dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="12dp">

        <!-- Header con estado -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tv_estado_revision"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@color/design_default_color_primary"
                android:paddingStart="8dp"
                android:paddingEnd="8dp"
                android:text="EJECUTADA"
                android:textColor="@android:color/white"
                android:textSize="12sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tv_modificaciones"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:text="Modificaciones: 0/3"
                android:textSize="11sp"
                android:textColor="@android:color/darker_gray" />

            <View
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1" />

            <TextView
                android:id="@+id/tv_tipo_desviacion_ejecutada"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@color/design_default_color_error"
                android:paddingStart="8dp"
                android:paddingEnd="8dp"
                android:text="ALTO"
                android:textColor="@android:color/white"
                android:textSize="12sp"
                android:textStyle="bold" />

        </LinearLayout>

        <!-- Medidor -->
        <TextView
            android:id="@+id/tv_medidor_ejecutada"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Medidor: 12345678"
            android:textSize="14sp"
            android:textStyle="bold" />

        <!-- Nombre -->
        <TextView
            android:id="@+id/tv_nombre_ejecutada"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="JUAN PEREZ"
            android:textSize="13sp" />

        <!-- Dirección -->
        <TextView
            android:id="@+id/tv_direccion_ejecutada"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="Calle 123 #45-67"
            android:textSize="12sp"
            android:textColor="@android:color/darker_gray" />

        <!-- Fecha ejecución -->
        <TextView
            android:id="@+id/tv_fecha_ejecucion"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="Ejecutada: 26/11/2025 10:30 AM"
            android:textSize="11sp"
            android:textColor="@android:color/darker_gray" />

        <!-- Indicador de reapertura disponible/bloqueada -->
        <TextView
            android:id="@+id/tv_estado_reapertura"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="✓ Puede reabrir"
            android:textSize="11sp"
            android:textColor="@color/design_default_color_primary"
            android:textStyle="bold" />

    </LinearLayout>

</androidx.cardview.widget.CardView>
