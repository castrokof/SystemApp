<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="16dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Tab 1: Toma de Lectura"
            android:textSize="18sp"
            android:textStyle="bold"
            android:layout_marginBottom="16dp" />

        <!-- Lectura Anterior (readonly) -->
        <com.google.android.material.textfield.TextInputLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Lectura Anterior"
            android:layout_marginBottom="12dp"
            app:startIconDrawable="@android:drawable/ic_menu_view">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/et_lectura_anterior"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:enabled="false"
                android:inputType="number"
                android:textStyle="bold" />

        </com.google.android.material.textfield.TextInputLayout>

        <!-- Lectura Actual -->
        <com.google.android.material.textfield.TextInputLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Lectura Actual *"
            android:layout_marginBottom="12dp"
            app:startIconDrawable="@android:drawable/ic_menu_view">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/et_lectura_actual"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="number" />

        </com.google.android.material.textfield.TextInputLayout>

        <!-- Consumo (calculado automáticamente) -->
        <com.google.android.material.textfield.TextInputLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Consumo (m³)"
            android:layout_marginBottom="12dp"
            app:startIconDrawable="@android:drawable/ic_menu_info_details">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/et_consumo"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:enabled="false"
                android:inputType="number"
                android:textColor="@color/design_default_color_primary"
                android:textStyle="bold" />

        </com.google.android.material.textfield.TextInputLayout>

        <!-- Indicador visual -->
        <TextView
            android:id="@+id/tv_indicador_consumo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@color/design_default_color_primary_variant"
            android:gravity="center"
            android:padding="12dp"
            android:text="Ingrese la lectura actual"
            android:textSize="13sp" />

    </LinearLayout>

</ScrollView>
