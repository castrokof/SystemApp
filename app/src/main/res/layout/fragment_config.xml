<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="24dp"
    android:background="@drawable/bg_liquid_gradient">

    <!-- Título -->
    <TextView
        android:id="@+id/title_config"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="⚙️ Configuración de Impresora"
        android:textSize="20sp"
        android:textStyle="bold"
        android:textColor="#1C1C1E"
        android:layout_marginTop="16dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Card Container -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/card_config"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        app:cardCornerRadius="20dp"
        app:cardElevation="2dp"
        app:strokeWidth="1dp"
        app:strokeColor="#20000000"
        app:layout_constraintTop_toBottomOf="@id/title_config"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp">

            <!-- Botón Buscar Dispositivos -->
            <Button
                android:id="@+id/btn_search_bluetooth"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:text="🔍 Buscar Dispositivos Bluetooth"
                android:textColor="#FFFFFF"
                android:textStyle="bold"
                android:background="@drawable/bg_button_primary"
                android:elevation="4dp" />

            <!-- Agrega esto después del botón de buscar -->
            <ProgressBar
                android:id="@+id/progress_search"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:visibility="gone"
                android:indeterminateTint="#0052FF"
                app:layout_constraintTop_toBottomOf="@id/btn_search_bluetooth"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent" />

            <TextView
                android:id="@+id/txt_search_status"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text=""
                android:textSize="14sp"
                android:textColor="#8E8E93"
                app:layout_constraintTop_toBottomOf="@id/progress_search"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent" />

            <!-- Spinner de Dispositivos -->
            <Spinner
                android:id="@+id/spinner_bluetooth_devices"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:layout_marginTop="16dp"
                android:background="@drawable/bg_spinner"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:visibility="gone" />

            <!-- Estado de Conexión -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="20dp"
                android:padding="12dp"
                android:background="@drawable/bg_pill"
                android:gravity="center_vertical">

                <ImageView
                    android:id="@+id/icon_status"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:src="@drawable/ic_bluetooth"
                    app:tint="#8E8E93" />

                <TextView
                    android:id="@+id/txtState_view"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="12dp"
                    android:text="Sin conexión"
                    android:textSize="14sp"
                    android:textColor="#8E8E93" />
            </LinearLayout>

            <!-- Impresora Seleccionada -->
            <TextView
                android:id="@+id/txt_selected_printer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="Impresora: Ninguna"
                android:textSize="14sp"
                android:textStyle="bold"
                android:textColor="#1C1C1E"
                android:padding="12dp"
                android:background="@drawable/bg_pill" />

            <!-- Ancho de papel térmico -->
            <TextView
                android:id="@+id/label_printer_width"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="Ancho de papel"
                android:textSize="14sp"
                android:textStyle="bold"
                android:textColor="#1C1C1E" />

            <RadioGroup
                android:id="@+id/radio_group_printer_width"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="8dp">

                <RadioButton
                    android:id="@+id/radio_width_58"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="58 mm"
                    android:checked="true" />

                <RadioButton
                    android:id="@+id/radio_width_80"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="80 mm" />
            </RadioGroup>

            <!-- Facturación en sitio -->
            <LinearLayout
                android:id="@+id/row_facturacion_sitio"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="20dp"
                android:gravity="center_vertical">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Facturación en sitio"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:textColor="#1C1C1E" />

                <Switch
                    android:id="@+id/switch_facturacion_sitio"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content" />
            </LinearLayout>

        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <!-- Botón Guardar (Fuera del card) -->
    <Button
        android:id="@+id/btn_mac_save"
        android:layout_width="0dp"
        android:layout_height="56dp"
        android:layout_marginTop="24dp"
        android:text="💾 Guardar Configuración"
        android:textColor="#FFFFFF"
        android:textStyle="bold"
        android:background="@drawable/bg_button_success"
        android:elevation="4dp"
        android:enabled="false"
        app:layout_constraintTop_toBottomOf="@id/card_config"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Botón Probar Impresión -->
    <Button
        android:id="@+id/btn_test_print"
        android:layout_width="0dp"
        android:layout_height="56dp"
        android:layout_marginTop="12dp"
        android:text="🖨️ Probar Impresión"
        android:textColor="#0052FF"
        android:textStyle="bold"
        android:background="@drawable/bg_button_outline"
        android:visibility="gone"
        app:layout_constraintTop_toBottomOf="@id/btn_mac_save"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Campo oculto para compatibilidad -->
    <EditText
        android:id="@+id/printer_name"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:visibility="gone"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

    <Spinner
        android:id="@+id/list_impresoras"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:visibility="gone"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>