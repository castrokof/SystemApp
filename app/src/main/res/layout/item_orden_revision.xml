<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="4dp"
    app:cardCornerRadius="8dp"
    app:cardElevation="2dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="12dp">

        <!-- Contenido principal -->
        <LinearLayout
            android:id="@+id/ll_content_revision"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <!-- Orden personalizada y tipo desviación -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/tv_orden_personalizada"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="#1"
                    android:textColor="@color/purple_500"
                    android:textSize="16sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tv_tipo_desviacion"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:background="@color/design_default_color_error"
                    android:paddingStart="8dp"
                    android:paddingEnd="8dp"
                    android:text="ALTO"
                    android:textColor="@android:color/white"
                    android:textSize="12sp"
                    android:textStyle="bold" />

            </LinearLayout>

            <!-- Medidor -->
            <TextView
                android:id="@+id/tv_medidor_revision"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="Medidor: 12345678"
                android:textSize="14sp"
                android:textStyle="bold" />

            <!-- Nombre -->
            <TextView
                android:id="@+id/tv_nombre_revision"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="JUAN PEREZ"
                android:textSize="13sp" />

            <!-- Dirección -->
            <TextView
                android:id="@+id/tv_direccion_revision"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="Calle 123 #45-67"
                android:textSize="12sp"
                android:textColor="@android:color/darker_gray" />

            <!-- Consumo promedio vs actual -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Promedio: "
                    android:textSize="12sp" />

                <TextView
                    android:id="@+id/tv_consumo_promedio"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="20 m³"
                    android:textSize="12sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:text="Actual: "
                    android:textSize="12sp" />

                <TextView
                    android:id="@+id/tv_consumo_actual"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="80 m³"
                    android:textSize="12sp"
                    android:textColor="@color/design_default_color_error"
                    android:textStyle="bold" />

            </LinearLayout>

        </LinearLayout>

        <!-- Icono de arrastre (drag handle) -->
        <ImageView
            android:id="@+id/iv_drag_handle"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_gravity="center"
            android:contentDescription="Arrastrar para reordenar"
            android:padding="8dp"
            android:src="@android:drawable/ic_menu_sort_by_size"
            android:tint="@color/purple_500" />

    </LinearLayout>

</androidx.cardview.widget.CardView>
